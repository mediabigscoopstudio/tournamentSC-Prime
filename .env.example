# Copy to .env and adjust. All values have safe dev defaults in settings.py.
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# Keep Django's built-in /django-admin/ available for developers only.
# Public users never see it; it is OFF by default. Set to True to enable.
ENABLE_DJANGO_ADMIN=False

# Production database (leave unset in dev to use SQLite):
# DATABASE_URL=postgres://user:pass@host:5432/tournamentsc

# Support mailbox (Hostinger). Leave EMAIL_BACKEND on the console default to
# print emails to the terminal instead of actually sending them.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=support@tournamentsc.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=support@tournamentsc.com
SITE_URL=https://tournamentsc.com
