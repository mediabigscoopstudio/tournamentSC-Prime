# Copy to .env and adjust. All values have safe dev defaults in settings.py.
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# Keep Django's built-in /django-admin/ available for developers only.
# Public users never see it; it is OFF by default. Set to True to enable.
ENABLE_DJANGO_ADMIN=False

# Production database (leave unset in dev to use SQLite):
# DATABASE_URL=postgres://user:pass@host:5432/tournamentsc

# Support mailbox (Hostinger). Leave EMAIL_BACKEND on the console default to
# print emails to the terminal instead of actually sending them.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=support@tournamentsc.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=support@tournamentsc.com
SITE_URL=https://tournamentsc.com

# Second mailbox — organizer/player lifecycle emails (published, fixtures
# created, completed, player welcome). Separate identity from support@ above.
TEAM_EMAIL_HOST_USER=team@tournamentsc.com
TEAM_EMAIL_HOST_PASSWORD=change-me
TEAM_FROM_EMAIL=team@tournamentsc.com

# Celery (async email). In production set CELERY_TASK_ALWAYS_EAGER=False and
# run a worker: celery -A tournamentsc worker -l info
CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=False

# Amazon S3 media storage (django-storages + boto3). Leave USE_S3_MEDIA
# unset (defaults to False) to keep serving media from local disk. Flip to
# True only after verifying bucket connectivity — see
# dash/tests/test_s3_storage.py.
# USE_S3_MEDIA=True
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# Set to run the live S3 connectivity test (real network calls to the
# bucket above): RUN_S3_CONNECTIVITY_TEST=1 python manage.py test dash.tests.test_s3_storage
# RUN_S3_CONNECTIVITY_TEST=

# Firebase Cloud Messaging (push notifications). Leave USE_FCM_PUSH unset
# (defaults to False) to keep notifications in-app only. Flip to True only
# after FIREBASE_CREDENTIALS_JSON points at a real service-account key file.
# USE_FCM_PUSH=True
FIREBASE_CREDENTIALS_JSON=
# Public web-app config (Firebase console -> Project settings -> Your apps).
# Safe to expose client-side — these are not secrets.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=
